      },
      "expected": {
        "status": "needs_agent",
        "reason": "Review contact fields",
        "context": {
          "row": 1
        }
      },
      "calls": [
        {
          "name": "files.read",
          "input": {
            "root": "contacts",
            "path": "contacts.json"
          },
          "result": {
            "text": "{\"rows\": [{\"name\": \"Ada\", \"email\": \"a b@example.com\"}]}"
          }
        }
      ]
    },
    {
      "name": "domain whitespace",
      "input": {
