        "context": {
          "row": 1
        }
      },
      "calls": [
        {
          "name": "files.read",
          "input": {
            "root": "contacts",
            "path": "contacts.json"
          },
          "result": {
            "text": "{\"rows\": [{\"name\": \"Ada\", \"email\": \"a@exam ple.com\"}]}"
          }
        }
      ]
    },
    {
      "name": "invalid document",
      "input": {
        "root": "contacts",
