{
  "contract": {
    "abi": 1,
    "name": "normalize-contact-file",
    "description": "Read a JSON contact document from a granted file, normalize names and emails, and keep the first name for each email. Malformed or unsupported documents return to the agent.",
    "input_schema": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": ["root", "path"],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        },
        "required": ["name", "email"],
        "additionalProperties": false
      }
    },
    "capabilities": ["files.read"]
  },
  "cases": [
    {
      "name": "normalize and deduplicate",
      "input": {
        "root": "contacts",
        "path": "contacts.json"
      },
      "expected": {
        "status": "completed",
        "output": [
          {
            "name": "Ada",
            "email": "ada@example.com"
          },
          {
            "name": "Bob",
            "email": "bob@example.com"
          }
        ]
      },
      "calls": [
        {
          "name": "files.read",
          "input": {
            "root": "contacts",
            "path": "contacts.json"
          },
          "result": {
            "text": "{\"rows\": [{\"name\": \" Ada \", \"email\": \" ADA@example.com \"}, {\"name\": \"Different\", \"email\": \"ada@example.com\"}, {\"name\": \" Bob\", \"email\": \"bob@example.com\"}]}"
          }
        }
      ]
    },
    {
      "name": "empty list",
      "input": {
        "root": "contacts",
        "path": "contacts.json"
      },
      "expected": {
        "status": "completed",
        "output": []
      },
      "calls": [
        {
          "name": "files.read",
          "input": {
            "root": "contacts",
            "path": "contacts.json"
          },
          "result": {
            "text": "{\"rows\": []}"
          }
        }
      ]
    },
    {
      "name": "missing name",
      "input": {
        "root": "contacts",
        "path": "contacts.json"
      },
      "expected": {
        "status": "needs_agent",
        "reason": "Missing contact fields",
        "context": {
          "row": 1
        }
      },
      "calls": [
        {
          "name": "files.read",
          "input": {
            "root": "contacts",
            "path": "contacts.json"
          },
          "result": {
            "text": "{\"rows\": [{\"email\": \"a@b.test\"}]}"
          }
        }
      ]
    },
    {
      "name": "invalid email",
      "input": {
        "root": "contacts",
        "path": "contacts.json"
      },
      "expected": {
        "status": "needs_agent",
        "reason": "Review contact fields",
        "context": {
          "row": 1
        }
      },
      "calls": [
        {
          "name": "files.read",
          "input": {
            "root": "contacts",
            "path": "contacts.json"
          },
          "result": {
            "text": "{\"rows\": [{\"name\": \"Ada\", \"email\": \"ada\"}]}"
          }
        }
      ]
    },
    {
      "name": "empty halves",
      "input": {
        "root": "contacts",
        "path": "contacts.json"
      },
      "expected": {
        "status": "needs_agent",
        "reason": "Review contact fields",
        "context": {
          "row": 1
        }
      },
      "calls": [
        {
          "name": "files.read",
          "input": {
            "root": "contacts",
            "path": "contacts.json"
          },
          "result": {
            "text": "{\"rows\": [{\"name\": \"Ada\", \"email\": \"@\"}]}"
          }
        }
      ]
    },
    {
      "name": "empty domain",
      "input": {
        "root": "contacts",
        "path": "contacts.json"
      },
      "expected": {
        "status": "needs_agent",
        "reason": "Review contact fields",
        "context": {
          "row": 1
        }
      },
      "calls": [
        {
          "name": "files.read",
          "input": {
            "root": "contacts",
            "path": "contacts.json"
          },
          "result": {
            "text": "{\"rows\": [{\"name\": \"Ada\", \"email\": \"alice@\"}]}"
          }
        }
      ]
    },
    {
      "name": "empty local",
      "input": {
        "root": "contacts",
        "path": "contacts.json"
      },
      "expected": {
        "status": "needs_agent",
        "reason": "Review contact fields",
        "context": {
          "row": 1
        }
      },
      "calls": [
        {
          "name": "files.read",
          "input": {
            "root": "contacts",
            "path": "contacts.json"
          },
          "result": {
            "text": "{\"rows\": [{\"name\": \"Ada\", \"email\": \"@example.com\"}]}"
          }
        }
      ]
    },
    {
