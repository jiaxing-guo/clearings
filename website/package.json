    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/mdx": "2.0.14",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "parse5": "8.1.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2"
