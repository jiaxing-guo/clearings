{
  "name": "clearings-semantic",
  "version": "0.0.1",
  "private": true,
  "description": "Internal representation for AI coding",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.9.0",
  "bin": {
    "clearings": "dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/inventory": "./schemas/inventory.v0.1.json",
    "./schemas/scan": "./schemas/scan.v0.1.json",
    "./schemas/semantic": "./schemas/semantic.v0.1.json",
    "./schemas/presentation": "./schemas/presentation.v0.1.json",
    "./schemas/contracts": "./schemas/semantic.v0.2.json",
    "./schemas/contract-presentation": "./schemas/presentation.v0.2.json",
    "./schemas/specification": "./schemas/specification.v0.3.json"
  },
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "benchmark:fetch": "node dist/cli/main.js benchmark-fetch --target benchmarks/targets/hono.json --out benchmark-checkouts/hono.git",
    "demo:build": "npm run build && node scripts/build-shared-demo.mjs",
    "docs:dev": "node scripts/prepare-docs.mjs && npm --prefix website run dev",
    "docs:build": "node scripts/prepare-docs.mjs && npm --prefix website run build",
    "docs:check": "npm --prefix website run typecheck && node scripts/check-docs.mjs",
    "bootstrap:demo": "npm run build && node scripts/build-bootstrap-demo.mjs",
    "docs:check:markdown": "npm run build && node scripts/check-markdown-docs.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3"
  }
}
