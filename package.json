{
  "name": "clearings-semantic",
  "version": "0.0.1",
  "private": true,
  "description": "Evidence-backed repository comprehension with structural scans and semantic proposal exchange",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.9.0",
  "bin": {
    "clearings": "dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/inventory": "./schemas/inventory.v0.1.json",
    "./schemas/scan": "./schemas/scan.v0.1.json",
    "./schemas/semantic": "./schemas/semantic.v0.1.json"
  },
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "benchmark:fetch": "node dist/cli/main.js benchmark-fetch --target benchmarks/targets/hono.json --out benchmark-checkouts/hono.git"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3"
  }
}
