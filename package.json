{
  "name": "clearings",
  "version": "0.0.1",
  "private": true,
  "description": "Internal representation for AI coding",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.9.0",
  "bin": {
    "clearings": "dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "import": "./dist/conformance/index.js"
    },
    "./schemas/inventory": "./schemas/inventory.v0.1.json",
    "./schemas/scan": "./schemas/scan.v0.1.json",
    "./schemas/semantic": "./schemas/semantic.v0.1.json",
    "./schemas/presentation": "./schemas/presentation.v0.1.json",
    "./schemas/contracts": "./schemas/semantic.v0.2.json",
    "./schemas/contract-presentation": "./schemas/presentation.v0.2.json",
    "./schemas/specification": "./schemas/specification.v0.3.json",
    "./schemas/conformance-profile": "./schemas/conformance-profile.v0.1.json",
    "./schemas/execution-record": "./schemas/execution-record.v0.1.json",
    "./program": {
      "types": "./dist/program/index.d.ts",
      "import": "./dist/program/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler/index.d.ts",
      "import": "./dist/compiler/index.js"
    },
    "./schemas/program": "./schemas/program.v0.1.json"
  },
  "files": [
    "dist",
    "schemas",
    "specifications/clearings/conformance/profile.json",
    "specifications/clearings/conformance/specification.json",
    "specifications/clearings/conformance/suite.json",
    "programs/examples/*.json",
    "programs/clearings/*.json",
    "runtime/rust/Cargo.toml",
    "runtime/rust/Cargo.lock",
    "runtime/rust/rust-toolchain.toml",
    "runtime/rust/src/*.rs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "conformance": "npm run build --silent && node dist/cli/main.js conformance",
    "test:conformance": "npm run build && node --test tests/conformance.test.mjs tests/context-recording.test.mjs tests/context-evaluation.test.mjs tests/conformance-cli.test.mjs && node scripts/check-context-conformance.mjs",
    "test:conformance:smoke": "npm run build && node scripts/check-context-conformance.mjs --smoke",
    "benchmark:fetch": "node dist/cli/main.js benchmark-fetch --target benchmarks/targets/hono.json --out benchmark-checkouts/hono.git",
    "demo:build": "npm run build && node scripts/build-shared-demo.mjs",
    "docs:dev": "node scripts/dev-docs.mjs",
    "docs:build": "npm run build && node scripts/prepare-docs.mjs && npm --prefix website run build",
    "docs:check": "npm --prefix website run typecheck && node scripts/check-docs.mjs",
    "bootstrap:demo": "npm run build && node scripts/build-bootstrap-demo.mjs",
    "docs:check:markdown": "npm run build && node scripts/check-markdown-docs.mjs",
    "test:program": "npm run build && node --test tests/program*.test.mjs",
    "test:rust": "cd runtime/rust && cargo test --locked --offline",
    "format:rust": "cd runtime/rust && cargo fmt",
    "check:rust": "cd runtime/rust && cargo fmt -- --check && cargo clippy --locked --offline --all-targets -- -D warnings",
    "program": "npm run build --silent && node dist/cli/main.js program",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "prettier": "3.9.6"
  }
}
