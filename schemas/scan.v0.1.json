{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "scan.v0.1.json",
  "title": "Clearings M1 structural scan 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "command": {
      "const": "scan"
    },
    "status": {
      "enum": [
        "complete",
        "partial"
      ]
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^(file|project|symbol|evidence|fact|scan):[a-f0-9]{64}$"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifest": {
          "$ref": "inventory.v0.1.json"
        },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "const": "typescript"
            },
            "version": {
              "const": "m1.1"
            },
            "compiler_version": {
              "const": "5.9.3"
            },
            "resolution_mode": {
              "const": "source-only"
            },
            "full_typecheck": {
              "const": false
            },
            "external_types_loaded": {
              "const": false
            },
            "max_file_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "max_total_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "max_source_files": {
              "type": "integer",
              "minimum": 1
            },
            "max_projects": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "name",
            "version",
            "compiler_version",
            "resolution_mode",
            "full_typecheck",
            "external_types_loaded",
            "max_file_bytes",
            "max_total_bytes",
            "max_source_files",
            "max_projects"
          ]
        },
        "projects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Project"
          }
        },
        "reads": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SourceRead"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SourceUnit"
          }
        },
        "symbols": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Declaration"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Evidence"
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Fact"
          }
        }
      },
      "required": [
        "manifest",
        "adapter",
        "projects",
        "reads",
        "files",
        "symbols",
        "evidence",
        "facts"
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Diagnostic"
      }
    },
    "coverage": {
      "$ref": "#/definitions/Coverage"
    }
  },
  "required": [
    "schema_version",
    "command",
    "status",
    "snapshot_id",
    "artifact_id",
    "data",
    "diagnostics",
    "coverage"
  ],
  "definitions": {
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(file|project|symbol|evidence|fact|scan):[a-f0-9]{64}$"
        },
        "config_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "config_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(file|project|symbol|evidence|fact|scan):[a-f0-9]{64}$"
          }
        },
        "source_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "selected_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "loaded",
            "failed"
          ]
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "base_url": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "paths": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "module": {
              "type": "string"
            },
            "module_resolution": {
              "type": "string"
            },
            "target": {
              "type": "string"
            },
            "jsx": {
              "type": "string"
            },
            "types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "base_url",
            "paths",
            "module",
            "module_resolution",
            "target",
            "jsx",
            "types"
          ]
        }
      },
      "required": [
        "id",
        "config_path",
        "config_sha256",
        "references",
        "source_files",
        "selected_files",
        "status",
        "options"
      ]
    },
    "SourceRead": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "blob_sha": {
          "type": "string",
          "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "purpose": {
          "enum": [
            "source",
            "config"
          ]
        }
      },
      "required": [
        "path",
        "blob_sha",
        "content_sha256",
        "size_bytes",
        "purpose"
      ]
    },
    "SourceUnit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(file|project|symbol|evidence|fact|scan):[a-f0-9]{64}$"
        },
        "path": {
          "type": "string"
        },
        "blob_sha": {
          "type": "string",
          "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "content_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "enum": [
            "selected",
            "support"
          ]
        },
        "status": {
          "enum": [
            "parsed",
            "failed"
          ]
        },
        "project_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(file|project|symbol|evidence|fact|scan):[a-f0-9]{64}$"
          }
        }
      },
      "required": [
        "id",
        "path",
        "blob_sha",
        "content_sha256",
        "size_bytes",
        "role",
        "status",
        "project_ids"
      ]
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(file|project|symbol|evidence|fact|scan):[a-f0-9]{64}$"
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "file_id": {
          "type": "string",
          "pattern": "^(file|project|symbol|evidence|fact|scan):[a-f0-9]{64}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^(file|project|symbol|evidence|fact|scan):[a-f0-9]{64}$"
        },
        "blob_sha": {
          "type": "string",
          "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "start_byte": {
          "type": "integer",
          "minimum": 0
        },
        "end_byte": {
          "type": "integer",
          "minimum": 0
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "start_column": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_column": {
          "type": "integer",
          "minimum": 1
        },
        "span_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "method": {
          "enum": [
            "typescript-syntax",
            "typescript-symbol"
          ]
        }
      },
      "required": [
        "id",
        "snapshot_id",
        "file_id",
        "project_id",
        "blob_sha",
        "content_sha256",
        "start_byte",
        "end_byte",
        "start_line",
        "start_column",
        "end_line",
        "end_column",
        "span_sha256",
        "method"
      ]
    },
    "Declaration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(file|project|symbol|evidence|fact|scan):[a-f0-9]{64}$"
        },
        "file_id": {
          "type": "string",
          "pattern": "^(file|project|symbol|evidence|fact|scan):[a-f0-9]{64}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^(file|project|symbol|evidence|fact|scan):[a-f0-9]{64}$"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "function",
            "variable",
            "parameter",
            "class",
            "method",
            "property",
            "interface",
            "type",
            "enum",
            "namespace",
            "binding"
          ]
        },
        "evidence_id": {
          "type": "string",
          "pattern": "^(file|project|symbol|evidence|fact|scan):[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "file_id",
        "project_id",
        "name",
        "kind",
        "evidence_id"
      ]
    },
    "Fact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(file|project|symbol|evidence|fact|scan):[a-f0-9]{64}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^(file|project|symbol|evidence|fact|scan):[a-f0-9]{64}$"
        },
        "kind": {
          "enum": [
            "declaration",
            "import",
            "export",
            "reference",
            "call",
            "dynamic-write"
          ]
        },
        "subject_id": {
          "type": "string",
          "pattern": "^(file|project|symbol|evidence|fact|scan):[a-f0-9]{64}$"
        },
        "target_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(file|project|symbol|evidence|fact|scan):[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "specifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "usage": {
          "enum": [
            "runtime",
            "type",
            "mixed"
          ]
        },
        "resolution": {
          "enum": [
            "observed",
            "resolved",
            "unresolved"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(file|project|symbol|evidence|fact|scan):[a-f0-9]{64}$"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "project_id",
        "kind",
        "subject_id",
        "target_id",
        "name",
        "specifier",
        "usage",
        "resolution",
        "reason",
        "evidence_ids"
      ]
    },
    "Diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "warning",
            "error"
          ]
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(file|project|symbol|evidence|fact|scan):[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "start_byte": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "end_byte": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "message",
        "severity",
        "path",
        "project_id",
        "start_byte",
        "end_byte"
      ]
    },
    "Coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tracked_entries": {
          "type": "integer",
          "minimum": 0
        },
        "selected_source_files": {
          "type": "integer",
          "minimum": 0
        },
        "parsed_source_files": {
          "type": "integer",
          "minimum": 0
        },
        "failed_source_files": {
          "type": "integer",
          "minimum": 0
        },
        "support_source_files": {
          "type": "integer",
          "minimum": 0
        },
        "failed_support_files": {
          "type": "integer",
          "minimum": 0
        },
        "inventory_only_entries": {
          "type": "integer",
          "minimum": 0
        },
        "facts": {
          "type": "integer",
          "minimum": 0
        },
        "resolved_references": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_references": {
          "type": "integer",
          "minimum": 0
        },
        "resolved_calls": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_calls": {
          "type": "integer",
          "minimum": 0
        },
        "resolved_imports": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_imports": {
          "type": "integer",
          "minimum": 0
        },
        "semantic_analysis": {
          "const": "not-run"
        }
      },
      "required": [
        "tracked_entries",
        "selected_source_files",
        "parsed_source_files",
        "failed_source_files",
        "support_source_files",
        "failed_support_files",
        "inventory_only_entries",
        "facts",
        "resolved_references",
        "unresolved_references",
        "resolved_calls",
        "unresolved_calls",
        "resolved_imports",
        "unresolved_imports",
        "semantic_analysis"
      ]
    }
  }
}
