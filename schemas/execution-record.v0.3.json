{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://clearings.dev/schemas/execution-record.v0.3.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "artifact_id",
    "origin",
    "profile_id",
    "specification_id",
    "case_id",
    "identities",
    "arguments_before",
    "arguments_after",
    "completion",
    "measurements",
    "limitations",
    "native_stages",
    "native_programs",
    "native_stage_errors"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "0.3.0"
      ]
    },
    "kind": {
      "enum": [
        "execution-record"
      ]
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^execution-record:[a-f0-9]{64}$"
    },
    "origin": {
      "enum": [
        "recorded-execution",
        "authored-example"
      ]
    },
    "profile_id": {
      "type": "string",
      "pattern": "^conformance-profile:[a-f0-9]{64}$"
    },
    "specification_id": {
      "type": "string",
      "pattern": "^specification:[a-f0-9]{64}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_.:/-]*$"
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "adapter",
        "evaluator",
        "fixture",
        "runtime"
      ],
      "properties": {
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "commit",
            "tree",
            "module",
            "export",
            "files"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "commit": {
              "type": "string",
              "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
            },
            "tree": {
              "type": "string",
              "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
            },
            "module": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*//)[^\\\\\\x00]+$"
            },
            "export": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_.:/-]*$"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*//)[^\\\\\\x00]+$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              },
              "minItems": 1
            }
          }
        },
        "adapter": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "name",
                "sha256"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "bound"
                  ]
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "reason"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "unavailable"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "evaluator": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "name",
                "sha256"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "bound"
                  ]
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "reason"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "unavailable"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "fixture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "sha256"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "runtime": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "name",
                "version",
                "platform",
                "architecture",
                "lockfile_sha256"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "bound"
                  ]
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "platform": {
                  "type": "string",
                  "minLength": 1
                },
                "architecture": {
                  "type": "string",
                  "minLength": 1
                },
                "lockfile_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "reason"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "unavailable"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      }
    },
    "arguments_before": {
      "$ref": "#/definitions/JsonValue"
    },
    "arguments_after": {
      "$ref": "#/definitions/CapturedValue"
    },
    "completion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "result"
          ],
          "properties": {
            "kind": {
              "enum": [
                "return"
              ]
            },
            "result": {
              "$ref": "#/definitions/CapturedValue"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "thrown"
          ],
          "properties": {
            "kind": {
              "enum": [
                "throw"
              ]
            },
            "thrown": {
              "$ref": "#/definitions/CapturedValue"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "limit_ms"
          ],
          "properties": {
            "kind": {
              "enum": [
                "timeout"
              ]
            },
            "limit_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "phase",
            "message"
          ],
          "properties": {
            "kind": {
              "enum": [
                "harness-failure"
              ]
            },
            "phase": {
              "enum": [
                "prepare",
                "invoke",
                "capture"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "measurements": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status",
              "value"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_.:/-]*$"
              },
              "status": {
                "enum": [
                  "observed"
                ]
              },
              "value": {
                "$ref": "#/definitions/JsonValue"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status",
              "reason"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_.:/-]*$"
              },
              "status": {
                "enum": [
                  "unobserved"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "native_stages": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "policy",
              "program_id",
              "compiled_artifact_id",
              "compiler_version",
              "execution_semantics_version",
              "runtime",
              "runner",
              "native",
              "limits",
              "usage",
              "completion",
              "stage",
              "arguments_sha256",
              "result_sha256",
              "result"
            ],
            "properties": {
              "status": {
                "enum": [
                  "observed"
                ]
              },
              "policy": {
                "enum": [
                  "context-native-v2"
                ]
              },
              "program_id": {
                "type": "string",
                "pattern": "^program:[a-f0-9]{64}$"
              },
              "compiled_artifact_id": {
                "type": "string",
                "pattern": "^compiled-program:[a-f0-9]{64}$"
              },
              "compiler_version": {
                "type": "string",
                "minLength": 1
              },
              "execution_semantics_version": {
                "type": "string",
                "minLength": 1
              },
              "runtime": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "abi_version",
                  "source_id"
                ],
                "properties": {
                  "abi_version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_id": {
                    "type": "string",
                    "pattern": "^rust-runtime:[a-f0-9]{64}$"
                  }
                }
              },
              "runner": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "version",
                  "source_id"
                ],
                "properties": {
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_id": {
                    "type": "string",
                    "pattern": "^rust-runner:[a-f0-9]{64}$"
                  }
                }
              },
              "native": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "build_id",
                  "executable_sha256",
                  "platform",
                  "architecture"
                ],
                "properties": {
                  "build_id": {
                    "type": "string",
                    "pattern": "^native-build:[a-f0-9]{64}$"
                  },
                  "executable_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "platform": {
                    "type": "string",
                    "minLength": 1
                  },
                  "architecture": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "limits": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "work",
                  "allocation_units",
                  "value_units",
                  "evaluation_depth"
                ],
                "properties": {
                  "work": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "allocation_units": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "value_units": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "evaluation_depth": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                }
              },
              "usage": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "work",
                  "allocation_units",
                  "value_units",
                  "evaluation_depth"
                ],
                "properties": {
                  "work": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "allocation_units": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "value_units": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "evaluation_depth": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                }
              },
              "completion": {
                "enum": [
                  "return",
                  "application-failure",
                  "runtime-fault",
                  "resource-exhaustion"
                ]
              },
              "stage": {
                "enum": [
                  "closure",
                  "selection"
                ]
              },
              "arguments_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "result_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "result": {
                "$ref": "#/definitions/JsonValue"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "status",
              "reason"
            ],
            "properties": {
              "stage": {
                "enum": [
                  "closure",
                  "selection"
                ]
              },
              "status": {
                "enum": [
                  "not-run"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "status",
              "reason"
            ],
            "properties": {
              "stage": {
                "enum": [
                  "closure",
                  "selection"
                ]
              },
              "status": {
                "enum": [
                  "unavailable"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "arguments_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        ]
      },
      "minItems": 2,
      "maxItems": 2
    },
    "native_programs": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "status",
              "path",
              "sha256",
              "program_id"
            ],
            "properties": {
              "stage": {
                "enum": [
                  "closure",
                  "selection"
                ]
              },
              "status": {
                "enum": [
                  "bound"
                ]
              },
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*//)[^\\\\\\x00]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "program_id": {
                "type": "string",
                "pattern": "^program:[a-f0-9]{64}$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "status",
              "reason"
            ],
            "properties": {
              "stage": {
                "enum": [
                  "closure",
                  "selection"
                ]
              },
              "status": {
                "enum": [
                  "unavailable"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      },
      "minItems": 2,
      "maxItems": 2
    },
    "native_stage_errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "maxItems": 8
    }
  },
  "definitions": {
    "JsonValue": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "number",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/JsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/JsonValue"
          }
        }
      ]
    },
    "ValueType": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "boolean",
                "string",
                "integer",
                "number",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "values"
          ],
          "properties": {
            "kind": {
              "enum": [
                "enum"
              ]
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "element"
          ],
          "properties": {
            "kind": {
              "enum": [
                "list"
              ]
            },
            "element": {
              "$ref": "#/definitions/ValueType"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "fields"
          ],
          "properties": {
            "kind": {
              "enum": [
                "record"
              ]
            },
            "fields": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_.:/-]*$",
                "maxLength": 256
              },
              "additionalProperties": {
                "$ref": "#/definitions/ValueType"
              }
            }
          }
        }
      ]
    },
    "CapturedValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "value"
          ],
          "properties": {
            "status": {
              "enum": [
                "captured"
              ]
            },
            "value": {
              "$ref": "#/definitions/JsonValue"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "enum": [
                "unavailable"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
