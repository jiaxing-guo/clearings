              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^claim:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "minItems": 1,
          "maxItems": 2000,
          "uniqueItems": true
        }
      },
      "required": [
        "condition",
        "destination_id",
        "claim_ids"
      ]
    },
    "Function": {
