  "definitions": {
    "Callable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^callable:[0-9a-f]{64}$"
        },
        "role": {
          "enum": [
            "function",
            "method",
            "getter",
            "setter",
            "arrow",
            "constructor"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000,
          "pattern": "\\S"
        },
        "symbol_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^symbol:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "enclosing_symbol_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^symbol:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_id": {
          "type": "string",
          "pattern": "^evidence:[0-9a-f]{64}$"
        },
        "start_byte": {
          "type": "integer",
          "minimum": 0
        },
        "end_byte": {
          "type": "integer",
          "minimum": 0
        },
        "span_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "role",
        "name",
        "symbol_id",
        "enclosing_symbol_id",
        "evidence_id",
        "start_byte",
        "end_byte",
        "span_sha256"
      ]
    },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "enum": [
            "0.2.0"
          ]
        },
        "command": {
          "enum": [
            "propose"
          ]
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "request_id": {
          "type": "string",
          "pattern": "^request:[0-9a-f]{64}$"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_request": {
              "$ref": "semantic.v0.1.json#/definitions/Request"
            },
            "callables": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Callable"
              },
              "minItems": 0,
              "maxItems": 2000,
              "uniqueItems": true
            },
            "max_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2097152
            },
            "instructions": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000,
              "pattern": "\\S"
            }
          },
          "required": [
            "source_request",
            "callables",
            "max_bytes",
            "instructions"
          ]
        }
      },
      "required": [
        "schema_version",
        "command",
        "snapshot_id",
        "request_id",
        "data"
      ]
    },
    "Failure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
