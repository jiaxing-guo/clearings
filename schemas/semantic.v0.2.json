                    "type": "string",
                    "pattern": "^concept:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  {
                    "type": "string",
                    "pattern": "^function:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  }
                ]
              },
              "claim_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^claim:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "minItems": 1,
                "maxItems": 2000,
                "uniqueItems": true
              }
            },
            "required": [
              "target_id",
              "claim_ids"
            ]
          },
          "minItems": 0,
          "maxItems": 2000,
          "uniqueItems": true
        },
        "assumption_claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^claim:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "minItems": 0,
          "maxItems": 2000,
          "uniqueItems": true
        },
        "unknown_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^unknown:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "minItems": 0,
          "maxItems": 2000,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "alias",
        "title",
        "component_id",
        "role",
        "implementation_id",
        "input_claim_ids",
        "output_claim_ids",
        "state_access",
        "effect_claim_ids",
        "failures",
        "dependencies",
        "assumption_claim_ids",
        "unknown_ids"
      ]
    },
    "Behavior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^behavior:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
