        "status": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^semantic:[0-9a-f]{64}$"
