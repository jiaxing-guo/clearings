            "relations": {
              "type": "array",
              "items": {
                "$ref": "semantic.v0.1.json#/definitions/Relation"
              },
              "minItems": 0,
              "maxItems": 2000,
              "uniqueItems": true
            },
            "flows": {
              "type": "array",
              "items": {
                "$ref": "semantic.v0.1.json#/definitions/Flow"
              },
              "minItems": 1,
              "maxItems": 2000,
              "uniqueItems": true
            },
            "functions": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Function"
              },
              "minItems": 1,
