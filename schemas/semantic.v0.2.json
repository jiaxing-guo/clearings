        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000,
          "pattern": "\\S"
        },
        "capability_id": {
          "type": "string",
          "pattern": "^concept:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "trigger_claim_ids": {
