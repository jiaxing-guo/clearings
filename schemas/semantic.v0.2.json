          },
          "minItems": 1,
          "maxItems": 2000,
          "uniqueItems": true
        },
        "state_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^concept:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "minItems": 0,
          "maxItems": 2000,
