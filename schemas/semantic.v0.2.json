{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semantic.v0.2.json",
  "oneOf": [
    {
      "$ref": "#/definitions/Request"
    },
    {
      "$ref": "#/definitions/Proposal"
    },
    {
      "$ref": "#/definitions/Model"
    }
