{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Clearings M0 inventory 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "command": {
      "const": "inventory"
    },
    "status": {
      "const": "complete"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool_version": {
          "const": "0.0.1"
        },
        "analysis_level": {
          "const": "inventory"
        },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "git-commit"
            },
            "object_format": {
              "enum": [
                "sha1",
                "sha256"
              ]
            },
            "commit_sha": {
              "type": "string",
              "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
            },
            "tree_sha": {
              "type": "string",
              "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
            }
          },
          "required": [
            "mode",
            "object_format",
            "commit_sha",
            "tree_sha"
          ]
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "include": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "exclude": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "include",
            "exclude"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "object_id": {
                "type": "string",
                "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
              },
              "mode": {
                "enum": [
                  "100644",
                  "100755",
                  "120000",
                  "160000"
                ]
              },
              "object_type": {
                "enum": [
                  "blob",
                  "commit"
                ]
              },
              "size_bytes": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "kind": {
                "enum": [
                  "source",
                  "declaration",
                  "config",
                  "other"
                ]
              },
              "test_named": {
                "type": "boolean"
              },
              "status": {
                "enum": [
                  "inventoried",
                  "excluded"
                ]
              },
              "reason": {
                "enum": [
                  "outside-scope",
                  "explicit-exclusion",
                  "symlink",
                  "submodule",
                  null
                ]
              }
            },
            "required": [
              "path",
              "object_id",
              "mode",
              "object_type",
              "size_bytes",
              "kind",
              "test_named",
              "status",
              "reason"
            ]
          }
        }
      },
      "required": [
        "tool_version",
        "analysis_level",
        "snapshot",
        "scope",
        "files"
      ]
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 0
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tracked_entries": {
          "type": "integer",
          "minimum": 0
        },
        "inventoried_files": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_entries": {
          "type": "integer",
          "minimum": 0
        },
        "inventoried_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "parsed_files": {
          "const": 0
        },
        "semantic_analysis": {
          "const": "not-run"
        }
      },
      "required": [
        "tracked_entries",
        "inventoried_files",
        "excluded_entries",
        "inventoried_bytes",
        "parsed_files",
        "semantic_analysis"
      ]
    }
  },
  "required": [
    "schema_version",
    "command",
    "status",
    "snapshot_id",
    "data",
    "diagnostics",
    "coverage"
  ]
}
