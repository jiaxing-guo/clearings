  "introduction": {
    "text": "Hono runs middleware with one shared request context. A call to next() enters the next handler. Response and error rules apply as each call completes.",
    "claim_ids": [
      "claim:87cd957c-bb51-49fe-b9a4-291c106e08c5",
      "claim:005c1ad3-dcc5-4f77-b36f-7ee4a420f22c",
      "claim:544dbd7e-acd1-4040-8b00-00b91c0e8f8d",
      "claim:fca39081-cbda-4fe7-8212-cf21fdc9a885",
      "claim:f67de3f4-647c-4c67-86e3-ab561267bf22"
    ],
    "unknown_indices": []
  },
  "stages": [
    {
      "key": "start",
      "title": "Start the request",
      "summary": {
        "text": "Each run starts with a new progress index. Dispatch starts at the first middleware entry.",
        "claim_ids": [
          "claim:a4808f91-eb8a-4a52-aed2-72effb4a139e",
          "claim:b1c5caa4-d40d-4e99-a478-a0483a83437a"
        ],
        "unknown_indices": []
      },
      "step_ids": [
        "step:0927dcdd-b4e6-47dc-bb6e-67ec8e86ee7d"
      ],
      "claim_ids": [
        "claim:a4808f91-eb8a-4a52-aed2-72effb4a139e",
        "claim:b1c5caa4-d40d-4e99-a478-a0483a83437a",
        "claim:39cc9873-5187-41f4-8403-332e355f7db9"
      ],
      "notes": [
        {
          "text": "The progress index starts at -1. It belongs to this invocation of the runner.",
          "claim_ids": [
            "claim:a4808f91-eb8a-4a52-aed2-72effb4a139e"
          ],
          "unknown_indices": []
        }
      ],
      "cautions": []
    },
    {
      "key": "guard",
      "title": "Reject repeated next calls",
      "summary": {
        "text": "Dispatch rejects an index that is not greater than the previous index.",
        "claim_ids": [
          "claim:25d1b193-56d5-4ad3-8be1-b7bb1bb30d2b"
        ],
        "unknown_indices": []
      },
      "step_ids": [
        "step:6b664680-e522-4784-922d-8f7b80992b82"
      ],
      "claim_ids": [
        "claim:25d1b193-56d5-4ad3-8be1-b7bb1bb30d2b",
        "claim:5a6d5b53-546a-4ad0-bb93-b028876d1d12",
        "claim:45c03f43-ef8c-4a6b-9f8a-24b2237fb6ca",
        "claim:d8b4fcf8-5869-40ef-a225-ff4e3d13bb99",
        "claim:e1b56a2f-0a30-4965-865a-3ab75c96f399"
      ],
      "notes": [
        {
          "text": "The guard prevents repeated or backward dispatch. It raises an Error before the current handler catch block.",
          "claim_ids": [
            "claim:25d1b193-56d5-4ad3-8be1-b7bb1bb30d2b",
            "claim:5a6d5b53-546a-4ad0-bb93-b028876d1d12"
          ],
          "unknown_indices": []
        }
      ],
      "cautions": [
        {
          "text": "A parent handler can still catch a failure from a child call. The guard does not bypass every error handler.",
          "claim_ids": [],
          "unknown_indices": [
            3
          ]
        }
      ]
    },
    {
      "key": "call",
      "title": "Run the next handler",
      "summary": {
        "text": "A call to next() enters the next middleware with the same context.",
        "claim_ids": [
          "claim:87cd957c-bb51-49fe-b9a4-291c106e08c5"
        ],
        "unknown_indices": []
      },
      "step_ids": [
        "step:a249dba7-bb8d-475a-a38d-a1a9cf7a9472",
        "step:6c021307-7902-43bc-9ed0-420de09fc078"
      ],
      "claim_ids": [
        "claim:b35b5c02-3b31-46cd-b1ac-2845ca7d8424",
        "claim:36389804-ee71-4da7-bbdc-e77cb1d247b1",
        "claim:957e5bca-529c-4b7b-85cd-d3ad15c57993",
        "claim:0df938c1-9773-4d05-84ba-5bcecf66fb6c",
        "claim:87cd957c-bb51-49fe-b9a4-291c106e08c5",
        "claim:005c1ad3-dcc5-4f77-b36f-7ee4a420f22c",
        "claim:2c55a0d3-2faf-413e-8173-4aa184a3094e",
        "claim:56b29496-273a-4a7a-ba0e-f3b36aff76a3",
        "claim:f360cf06-1fc5-4b71-891d-37fdddbfeaa4"
      ],
      "notes": [
        {
          "text": "Dispatch updates the progress index and selects a handler. It also sets context.req.routeIndex.",
          "claim_ids": [
            "claim:b35b5c02-3b31-46cd-b1ac-2845ca7d8424",
            "claim:36389804-ee71-4da7-bbdc-e77cb1d247b1",
            "claim:957e5bca-529c-4b7b-85cd-d3ad15c57993"
          ],
          "unknown_indices": []
        },
        {
          "text": "At exactly middleware.length, dispatch can select the outer next callback if no middleware entry exists.",
          "claim_ids": [
            "claim:0df938c1-9773-4d05-84ba-5bcecf66fb6c"
          ],
          "unknown_indices": []
        },
        {
          "text": "Dispatch waits for each handler result. It accepts both direct return values and promises.",
          "claim_ids": [
            "claim:005c1ad3-dcc5-4f77-b36f-7ee4a420f22c"
          ],
          "unknown_indices": []
        }
      ],
      "cautions": [
        {
          "text": "The return order in the example requires await next(). Whether a user handler waits is outside these excerpts.",
          "claim_ids": [],
          "unknown_indices": [
            2
          ]
        }
      ]
    },
    {
      "key": "response",
      "title": "Keep or update the response",
      "summary": {
        "text": "A truthy result can update context.res. An existing finalized response is kept unless the result came from onError.",
        "claim_ids": [
          "claim:fca39081-cbda-4fe7-8212-cf21fdc9a885",
          "claim:1724bbd4-e936-42d3-a4cd-dabd7f2051aa",
          "claim:d5e3c85d-4a1d-4991-87d8-bd5369c091ab",
          "claim:7f3aafe6-876f-4b5a-9bac-698144b2adfc"
        ],
        "unknown_indices": []
      },
      "step_ids": [
        "step:d21a3bf3-b439-475c-9894-7cd0977c85ed",
        "step:9394aaf0-1e44-40f5-b32c-3af2d70a285f",
        "step:0f2e7303-9908-4bae-9695-1247c8ce948a"
      ],
      "claim_ids": [
        "claim:e8b03c7a-182a-46d4-aeb8-bf4295b82798",
        "claim:6b252ce9-9a3f-4cdb-9248-b0e515420829",
        "claim:fca39081-cbda-4fe7-8212-cf21fdc9a885",
        "claim:1724bbd4-e936-42d3-a4cd-dabd7f2051aa",
        "claim:d5e3c85d-4a1d-4991-87d8-bd5369c091ab",
        "claim:7f3aafe6-876f-4b5a-9bac-698144b2adfc",
        "claim:f67de3f4-647c-4c67-86e3-ab561267bf22",
        "claim:0b57c11a-c767-4573-8888-f3d49cbdf5c6",
        "claim:146991bd-ed7d-4ae1-8868-888a11dedf6e",
        "claim:161b91b9-a49b-44d3-a919-0758464c5af3",
        "claim:1d2eae5b-efd0-4237-8671-50d5055dafe0",
        "claim:5e705c38-4dd9-4e55-be1b-2f016881b2bd",
        "claim:8099fdae-3db1-47b0-b324-6d527a067dd6",
        "claim:a6cc6269-0179-4714-a6d7-a690685fd58b",
        "claim:b3a42479-5499-4eed-8d21-09169deaf214",
        "claim:d543fd57-c7cb-4a8b-9078-fc6050980cf1",
        "claim:d5dd3300-e498-4ec8-b548-9d8308c15576",
        "claim:f984c4f5-e5e0-4ce9-a0fc-0b8884e34883"
      ],
      "notes": [
        {
          "text": "If no handler exists, onNotFound runs only when finalized is false and the callback exists.",
          "claim_ids": [
            "claim:e8b03c7a-182a-46d4-aeb8-bf4295b82798"
          ],
          "unknown_indices": []
        },
        {
          "text": "A falsy result does not update context.res. A completed dispatch call returns the shared context.",
          "claim_ids": [
            "claim:7f3aafe6-876f-4b5a-9bac-698144b2adfc",
            "claim:f67de3f4-647c-4c67-86e3-ab561267bf22"
          ],
          "unknown_indices": []
        }
      ],
      "cautions": [
        {
          "text": "The not-found callback runs outside the current handler catch block. A truthy onError result can replace a finalized response.",
          "claim_ids": [
            "claim:6b252ce9-9a3f-4cdb-9248-b0e515420829",
            "claim:d5e3c85d-4a1d-4991-87d8-bd5369c091ab"
          ],
          "unknown_indices": []
        }
      ]
    },
    {
      "key": "failure",
      "title": "Handle or pass on an error",
      "summary": {
        "text": "The handler catch uses onError only for an Error instance when that callback exists.",
        "claim_ids": [
          "claim:544dbd7e-acd1-4040-8b00-00b91c0e8f8d"
        ],
        "unknown_indices": []
      },
      "step_ids": [
        "step:6d99d430-1030-4bbe-8278-8707ffcc2e1f",
        "step:2b229a25-c063-4a7c-ab4a-5b90f609670e"
      ],
      "claim_ids": [
        "claim:25d1b193-56d5-4ad3-8be1-b7bb1bb30d2b",
        "claim:544dbd7e-acd1-4040-8b00-00b91c0e8f8d",
        "claim:6a188938-736d-4970-a698-88df4b787329",
        "claim:3744e538-0f07-4ea4-a210-02d1a6c03781",
        "claim:37cba2c0-333b-4a16-b503-49cd1b020ffa",
        "claim:40001f0b-2785-462a-9244-1997813e69cd",
        "claim:6b252ce9-9a3f-4cdb-9248-b0e515420829",
        "claim:5a6d5b53-546a-4ad0-bb93-b028876d1d12",
        "claim:eb4d17a9-fa20-4ecc-9768-52ed19a28dea"
      ],
      "notes": [
        {
          "text": "Before onError runs, dispatch stores the Error in context.error. It marks the returned result as an error response.",
          "claim_ids": [
            "claim:6a188938-736d-4970-a698-88df4b787329",
            "claim:3744e538-0f07-4ea4-a210-02d1a6c03781"
          ],
          "unknown_indices": []
        },
        {
          "text": "If the thrown value is not an Error, or onError is absent, the call rethrows the value.",
          "claim_ids": [
            "claim:37cba2c0-333b-4a16-b503-49cd1b020ffa"
          ],
          "unknown_indices": []
        },
        {
          "text": "A failure inside onError escapes the current handler catch block.",
          "claim_ids": [
            "claim:40001f0b-2785-462a-9244-1997813e69cd"
          ],
          "unknown_indices": []
        }
      ],
      "cautions": [
        {
          "text": "A failure from a child dispatch can reach an awaiting parent or the application dispatcher. Handling depends on that caller.",
          "claim_ids": [],
          "unknown_indices": [
            3
          ]
        }
      ]
    }
  ],
  "cases": [
    {
      "key": "return-order",
      "question": "Why does code after await next() run later?",
      "answer": [
        {
          "text": "next() enters the next dispatch call. If the middleware waits with await next(), it resumes after that child call completes.",
          "claim_ids": [
            "claim:87cd957c-bb51-49fe-b9a4-291c106e08c5",
            "claim:005c1ad3-dcc5-4f77-b36f-7ee4a420f22c"
          ],
          "unknown_indices": [
            2
          ]
        },
        {
          "text": "The diagram assumes this waiting behavior. User handlers can choose a different behavior.",
          "claim_ids": [],
          "unknown_indices": [
            2
          ]
        }
      ],
      "stage_keys": [
        "call",
        "response"
      ]
    },
    {
      "key": "repeat",
      "question": "What happens if next() is called twice?",
      "answer": [
        {
          "text": "The progress guard rejects a repeated index. Its Error occurs before that call enters its own handler catch block.",
          "claim_ids": [
            "claim:25d1b193-56d5-4ad3-8be1-b7bb1bb30d2b",
            "claim:5a6d5b53-546a-4ad0-bb93-b028876d1d12"
          ],
          "unknown_indices": []
        },
        {
          "text": "An awaiting parent can still handle the failure. The source does not establish that all error callbacks are bypassed.",
          "claim_ids": [],
          "unknown_indices": [
            3
          ]
        }
      ],
      "stage_keys": [
        "guard",
        "failure"
      ]
    },
    {
      "key": "replace",
      "question": "Can a returned response replace an existing response?",
      "answer": [
        {
          "text": "A normal result does not overwrite a finalized response through this assignment. A truthy result from onError can replace it.",
          "claim_ids": [
            "claim:fca39081-cbda-4fe7-8212-cf21fdc9a885",
            "claim:1724bbd4-e936-42d3-a4cd-dabd7f2051aa",
            "claim:d5e3c85d-4a1d-4991-87d8-bd5369c091ab"
          ],
          "unknown_indices": []
        },
        {
          "text": "A falsy result causes no response assignment.",
          "claim_ids": [
            "claim:7f3aafe6-876f-4b5a-9bac-698144b2adfc"
          ],
          "unknown_indices": []
        }
      ],
      "stage_keys": [
        "response"
      ]
    },
    {
      "key": "no-handler",
      "question": "What happens when there is no handler?",
      "answer": [
        {
          "text": "At exactly middleware.length, dispatch can use the supplied outer next callback.",
          "claim_ids": [
            "claim:0df938c1-9773-4d05-84ba-5bcecf66fb6c"
          ],
          "unknown_indices": []
        },
        {
          "text": "If no handler is selected, onNotFound runs only when finalized is false and that callback exists. Its invocation is outside the current handler catch block.",
          "claim_ids": [
            "claim:e8b03c7a-182a-46d4-aeb8-bf4295b82798",
            "claim:6b252ce9-9a3f-4cdb-9248-b0e515420829"
          ],
          "unknown_indices": []
        }
      ],
      "stage_keys": [
        "call",
        "response",
        "failure"
      ]
    },
    {
      "key": "error-handler",
      "question": "What if the error handler also throws?",
      "answer": [
        {
          "text": "That failure escapes the current handler catch block. An awaiting parent or application dispatcher may handle it.",
          "claim_ids": [
            "claim:40001f0b-2785-462a-9244-1997813e69cd"
          ],
          "unknown_indices": [
            3
          ]
        }
      ],
      "stage_keys": [
        "failure"
      ]
    }
  ],
