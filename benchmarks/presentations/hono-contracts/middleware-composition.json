  "overview": {
    "title": "How request steps work together",
    "purpose": {
      "text": "Hono lets several functions work on the same request. Each function can pass work to the next one and use the shared result.",
      "claim_ids": [
        "claim:87cd957c-bb51-49fe-b9a4-291c106e08c5",
        "claim:005c1ad3-dcc5-4f77-b36f-7ee4a420f22c",
        "claim:fca39081-cbda-4fe7-8212-cf21fdc9a885",
        "claim:f67de3f4-647c-4c67-86e3-ab561267bf22"
      ],
      "unknown_indices": []
    },
    "journey": [
      {
        "title": "Share the request",
        "summary": {
          "text": "Each function receives the same request context.",
          "claim_ids": [
            "claim:87cd957c-bb51-49fe-b9a4-291c106e08c5"
          ],
          "unknown_indices": []
        }
      },
      {
        "title": "Pass work forward",
        "summary": {
          "text": "A function can call the next function.",
          "claim_ids": [
            "claim:87cd957c-bb51-49fe-b9a4-291c106e08c5"
          ],
          "unknown_indices": []
        }
      },
      {
        "title": "Continue when work finishes",
        "summary": {
          "text": "If a function waits for later work, it resumes after that work completes.",
          "claim_ids": [
            "claim:87cd957c-bb51-49fe-b9a4-291c106e08c5",
            "claim:005c1ad3-dcc5-4f77-b36f-7ee4a420f22c"
          ],
          "unknown_indices": [
            2
          ]
        }
      }
    ],
