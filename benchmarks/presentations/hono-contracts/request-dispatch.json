  "stages": [
    {
      "key": "method",
      "title": "Choose the request method",
      "summary": {
        "text": "For requests other than HEAD, Hono uses the supplied method. For HEAD, it uses GET and returns a response without a body.",
        "claim_ids": [
          "claim:be525e2a-9f68-4196-b67c-7bf670fbee39",
          "claim:085248c3-81b0-4cad-986d-05fee44fe506",
          "claim:f30ea83a-a386-4f3c-93af-21067f7f47cb"
        ],
