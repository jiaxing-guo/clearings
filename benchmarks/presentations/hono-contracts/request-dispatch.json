      "notes": [
        {
          "text": "The direct path checks whether the result is a Promise. This choice affects response selection.",
          "claim_ids": [
            "claim:3ebf7dad-d613-4994-9e9e-f59bb1d79317"
          ],
          "unknown_indices": []
        },
        {
          "text": "The composition path uses the configured error and not-found handlers. The dispatcher waits for the composed runner.",
