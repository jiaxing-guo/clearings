  "review_status": "unreviewed",
  "introduction": {
    "text": "Hono receives a request, finds matching handlers, and selects a response. The selected path also determines how it handles missing responses and failures.",
    "claim_ids": [
      "claim:be525e2a-9f68-4196-b67c-7bf670fbee39",
      "claim:8b0483bd-c519-497b-b081-d286863646b7",
      "claim:3c7751cc-3137-4636-a809-aa2a0ee43c9e",
      "claim:876a95e6-ca91-46c2-b831-60091068b69d",
      "claim:abe1d0e6-876f-40a3-b8e1-aac696dd56f5",
      "claim:2639197b-bb38-4ed2-9817-07e369a77759",
      "claim:7ce9d699-11e2-481a-866e-c1e4356ea24d",
      "claim:f5f65ad6-ca98-41d8-95dd-293ac83d5f15"
    ],
    "unknown_indices": []
  },
  "stages": [
    {
      "key": "method",
      "title": "Choose the request method",
      "summary": {
        "text": "For requests other than HEAD, Hono uses the supplied method. For HEAD, it uses GET and returns a response without a body.",
        "claim_ids": [
          "claim:be525e2a-9f68-4196-b67c-7bf670fbee39",
          "claim:085248c3-81b0-4cad-986d-05fee44fe506",
          "claim:f30ea83a-a386-4f3c-93af-21067f7f47cb"
        ],
        "unknown_indices": []
      },
      "step_ids": [
        "step:fdc5198f-dec9-4c31-a00f-59b930e9e076",
        "step:c8e6ec4b-17bf-4637-8e47-40b6b7b992f7"
      ],
      "claim_ids": [
        "claim:be525e2a-9f68-4196-b67c-7bf670fbee39",
        "claim:085248c3-81b0-4cad-986d-05fee44fe506",
        "claim:f30ea83a-a386-4f3c-93af-21067f7f47cb"
      ],
      "notes": [
        {
          "text": "The request enters through fetch. Hono passes the request, environment, and execution context to its dispatcher.",
          "claim_ids": [
            "claim:be525e2a-9f68-4196-b67c-7bf670fbee39"
          ],
          "unknown_indices": []
        },
        {
          "text": "For HEAD, only the dispatch method argument changes to GET. The original Request object stays the same.",
          "claim_ids": [
            "claim:085248c3-81b0-4cad-986d-05fee44fe506"
          ],
          "unknown_indices": []
        }
      ],
      "cautions": [
        {
          "text": "A failure from the HEAD wrapper is not guaranteed to reach the local error callback.",
          "claim_ids": [],
          "unknown_indices": [
            4
          ]
        }
      ]
    },
    {
      "key": "match",
      "title": "Find matching handlers",
      "summary": {
        "text": "Hono resolves the path, matches routes, and creates the request context.",
        "claim_ids": [
          "claim:889f741d-3df0-47f5-9e19-2a06a2a99445",
          "claim:8b0483bd-c519-497b-b081-d286863646b7",
          "claim:6ea34fc3-66d3-437b-a99c-f67c5043f6b6"
        ],
        "unknown_indices": []
      },
      "step_ids": [
        "step:c9a85946-abf2-4a8e-9dec-59fa95a966f1"
      ],
      "claim_ids": [
        "claim:889f741d-3df0-47f5-9e19-2a06a2a99445",
        "claim:8b0483bd-c519-497b-b081-d286863646b7",
        "claim:6ea34fc3-66d3-437b-a99c-f67c5043f6b6"
      ],
      "notes": [
        {
          "text": "The router receives the dispatch method and resolved path. The context stores the match result and request data.",
          "claim_ids": [
            "claim:8b0483bd-c519-497b-b081-d286863646b7",
            "claim:6ea34fc3-66d3-437b-a99c-f67c5043f6b6"
          ],
          "unknown_indices": []
        }
      ],
      "cautions": [
        {
          "text": "These excerpts do not establish router internals or user handler behavior. Failures during this setup occur before the shown handler catch blocks.",
          "claim_ids": [],
          "unknown_indices": [
            0,
            1
          ]
        }
      ]
    },
    {
      "key": "handlers",
      "title": "Choose the handler path",
      "summary": {
        "text": "One matching handler runs directly. Zero or multiple handlers use middleware composition.",
        "claim_ids": [
          "claim:3c7751cc-3137-4636-a809-aa2a0ee43c9e",
          "claim:2639197b-bb38-4ed2-9817-07e369a77759"
        ],
        "unknown_indices": []
      },
      "step_ids": [
        "step:3301e9a4-0b62-40b9-bcc5-74652de3839a",
        "step:cdf57463-13f7-4ae8-9709-ea1462e942d2",
        "step:bd8c16b3-f9f9-4211-93a8-0cfd6fdef1f3"
      ],
      "claim_ids": [
        "claim:3c7751cc-3137-4636-a809-aa2a0ee43c9e",
        "claim:d4c7dc38-cdfc-4a47-b9f5-c3628df16210",
        "claim:3a465dfd-a823-4297-a867-dc7b31edd393",
        "claim:3ebf7dad-d613-4994-9e9e-f59bb1d79317",
        "claim:2639197b-bb38-4ed2-9817-07e369a77759",
        "claim:c3467e33-ffa9-47f6-8a0f-934dcdd6024c",
        "claim:f551142e-2ef8-4131-9da8-304f6a92329e"
      ],
      "notes": [
        {
          "text": "The direct path checks whether the result is a Promise. This choice affects response selection.",
          "claim_ids": [
            "claim:3ebf7dad-d613-4994-9e9e-f59bb1d79317"
          ],
          "unknown_indices": []
        },
        {
          "text": "The composition path uses the configured error and not-found handlers. The dispatcher waits for the composed runner.",
          "claim_ids": [
            "claim:c3467e33-ffa9-47f6-8a0f-934dcdd6024c",
            "claim:f551142e-2ef8-4131-9da8-304f6a92329e"
          ],
          "unknown_indices": []
        },
        {
          "text": "The next callback supplied to a direct handler assigns the configured not-found result to c.res.",
          "claim_ids": [
            "claim:d4c7dc38-cdfc-4a47-b9f5-c3628df16210"
          ],
          "unknown_indices": []
        }
      ],
      "cautions": []
    },
    {
      "key": "response",
      "title": "Select the response",
      "summary": {
        "text": "Hono selects a response using the rules for the chosen handler path.",
        "claim_ids": [
          "claim:32832fda-23d3-411c-8392-6782b3634057",
          "claim:876a95e6-ca91-46c2-b831-60091068b69d",
          "claim:abe1d0e6-876f-40a3-b8e1-aac696dd56f5",
          "claim:b962178a-0e5d-4e27-a698-38b48e7fdd3a",
          "claim:7ce9d699-11e2-481a-866e-c1e4356ea24d"
        ],
        "unknown_indices": []
      },
      "step_ids": [
        "step:7539d22f-ed85-48df-bba7-ca69334adb90",
        "step:6f7b0430-e901-4ab6-9a3d-b088f2b012e8",
        "step:4ccc4676-c52d-4d20-ab3d-7578bfedcda6",
        "step:78c04a66-b80a-4358-8b55-58a8d1523e29"
      ],
      "claim_ids": [
        "claim:32832fda-23d3-411c-8392-6782b3634057",
        "claim:876a95e6-ca91-46c2-b831-60091068b69d",
        "claim:6b5a8b30-ea42-46e9-880d-53099dbe6c56",
        "claim:abe1d0e6-876f-40a3-b8e1-aac696dd56f5",
        "claim:b962178a-0e5d-4e27-a698-38b48e7fdd3a",
        "claim:7ce9d699-11e2-481a-866e-c1e4356ea24d",
        "claim:75a7f499-e2f0-4998-89a5-48c6456d3bab",
        "claim:6f5292fe-ce44-4891-9436-47ae3462ead0",
        "claim:161b91b9-a49b-44d3-a919-0758464c5af3",
        "claim:1d2eae5b-efd0-4237-8671-50d5055dafe0",
        "claim:146991bd-ed7d-4ae1-8868-888a11dedf6e",
        "claim:0b57c11a-c767-4573-8888-f3d49cbdf5c6",
        "claim:5e705c38-4dd9-4e55-be1b-2f016881b2bd",
        "claim:bf2950af-c55d-401a-9691-50acf819a3f2"
      ],
      "notes": [
        {
          "text": "If a Promise resolves to a truthy value, Hono returns that value. Otherwise, Hono uses c.res if finalized is true. If finalized is false, Hono calls the not-found handler.",
          "claim_ids": [
            "claim:32832fda-23d3-411c-8392-6782b3634057",
            "claim:876a95e6-ca91-46c2-b831-60091068b69d"
          ],
          "unknown_indices": []
        },
        {
          "text": "If a direct result is not a Promise, Hono returns it unless it is null or undefined. For those two values, Hono calls the not-found handler.",
          "claim_ids": [
            "claim:abe1d0e6-876f-40a3-b8e1-aac696dd56f5"
          ],
          "unknown_indices": []
        },
        {
          "text": "After composition, Hono requires a finalized context. It then returns context.res. If the context is not finalized, Hono raises an Error.",
          "claim_ids": [
            "claim:b962178a-0e5d-4e27-a698-38b48e7fdd3a",
            "claim:7ce9d699-11e2-481a-866e-c1e4356ea24d"
          ],
          "unknown_indices": []
        },
        {
          "text": "The context starts with finalized set to false. Reading res alone does not finalize it. The res setter sets finalized to true, even for undefined.",
          "claim_ids": [
            "claim:6f5292fe-ce44-4891-9436-47ae3462ead0",
            "claim:161b91b9-a49b-44d3-a919-0758464c5af3",
            "claim:1d2eae5b-efd0-4237-8671-50d5055dafe0"
          ],
          "unknown_indices": []
        },
        {
          "text": "When old and new responses exist, the setter merges old headers except content-type. Old set-cookie values replace the new cookie collection.",
          "claim_ids": [
            "claim:146991bd-ed7d-4ae1-8868-888a11dedf6e",
            "claim:0b57c11a-c767-4573-8888-f3d49cbdf5c6"
          ],
          "unknown_indices": []
        },
        {
          "text": "The supplied default not-found handler returns a text response with status 404. A custom handler can behave differently.",
          "claim_ids": [
            "claim:75a7f499-e2f0-4998-89a5-48c6456d3bab"
          ],
          "unknown_indices": []
        },
        {
          "text": "Context.notFound installs a fallback callback only when its stored handler is null or undefined. It then calls that handler with the context.",
          "claim_ids": [
            "claim:5e705c38-4dd9-4e55-be1b-2f016881b2bd"
          ],
          "unknown_indices": []
        }
      ],
      "cautions": [
        {
          "text": "A missing direct result and a falsy Promise result use different fallback rules. Only the Promise fallback checks finalized.",
          "claim_ids": [
            "claim:876a95e6-ca91-46c2-b831-60091068b69d",
            "claim:abe1d0e6-876f-40a3-b8e1-aac696dd56f5"
          ],
          "unknown_indices": []
        }
      ]
    },
    {
      "key": "failure",
      "title": "Handle a failure",
      "summary": {
        "text": "The private error handler sends Error instances to the configured callback. It rethrows other values.",
        "claim_ids": [
          "claim:f5f65ad6-ca98-41d8-95dd-293ac83d5f15"
        ],
        "unknown_indices": []
      },
      "step_ids": [
        "step:6e269ade-b6c0-4442-8553-6445a5fbbb6e",
        "step:95622008-6e00-4397-9d3b-37cf7633368e"
      ],
      "claim_ids": [
        "claim:3a465dfd-a823-4297-a867-dc7b31edd393",
        "claim:6b5a8b30-ea42-46e9-880d-53099dbe6c56",
        "claim:7af68846-ae57-44cd-8e06-49e5596a226b",
        "claim:f5f65ad6-ca98-41d8-95dd-293ac83d5f15",
        "claim:4a289f87-40be-45fa-90f8-f07a20dcafb8",
        "claim:4e81a050-0232-49a7-bf88-ebfbdc1e9576",
        "claim:bf2950af-c55d-401a-9691-50acf819a3f2"
      ],
      "notes": [
        {
          "text": "The direct handler catch, direct Promise rejection handler, and composed path catch call the private error handler.",
          "claim_ids": [
            "claim:3a465dfd-a823-4297-a867-dc7b31edd393",
            "claim:6b5a8b30-ea42-46e9-880d-53099dbe6c56",
            "claim:7af68846-ae57-44cd-8e06-49e5596a226b"
          ],
          "unknown_indices": []
        },
        {
          "text": "The default error handler can use getResponse. Otherwise, it logs the error and creates a text response with status 500.",
          "claim_ids": [
            "claim:4a289f87-40be-45fa-90f8-f07a20dcafb8",
            "claim:4e81a050-0232-49a7-bf88-ebfbdc1e9576"
          ],
          "unknown_indices": []
        }
      ],
      "cautions": [
        {
          "text": "The direct not-found fallback runs outside the direct handler catch block. A throw there can reach the caller.",
          "claim_ids": [
            "claim:bf2950af-c55d-401a-9691-50acf819a3f2"
          ],
          "unknown_indices": []
        }
      ]
    }
  ],
  "cases": [
    {
      "key": "head",
      "question": "What happens for a HEAD request?",
      "answer": [
        {
          "text": "Hono dispatches with GET as the method argument, while it keeps the original request. It then creates a response with a null body.",
          "claim_ids": [
            "claim:085248c3-81b0-4cad-986d-05fee44fe506",
            "claim:f30ea83a-a386-4f3c-93af-21067f7f47cb"
          ],
          "unknown_indices": []
        },
        {
          "text": "The shown wrapper does not guarantee local handling of every rejection.",
          "claim_ids": [],
          "unknown_indices": [
            4
          ]
        }
      ],
      "stage_keys": [
        "method",
        "failure"
      ]
    },
    {
      "key": "one-handler",
      "question": "What happens with one matching handler?",
      "answer": [
        {
          "text": "Hono calls the handler directly. It then selects the Promise or direct return path from the returned value.",
          "claim_ids": [
            "claim:3c7751cc-3137-4636-a809-aa2a0ee43c9e",
            "claim:3ebf7dad-d613-4994-9e9e-f59bb1d79317"
          ],
          "unknown_indices": []
        }
      ],
      "stage_keys": [
        "handlers",
        "response"
      ]
    },
    {
      "key": "many-handlers",
      "question": "What happens with zero or multiple handlers?",
      "answer": [
        {
          "text": "Both cases use compose with the configured error and not-found handlers. Hono waits for the result, then requires a finalized context.",
          "claim_ids": [
            "claim:2639197b-bb38-4ed2-9817-07e369a77759",
            "claim:c3467e33-ffa9-47f6-8a0f-934dcdd6024c",
            "claim:f551142e-2ef8-4131-9da8-304f6a92329e",
            "claim:b962178a-0e5d-4e27-a698-38b48e7fdd3a"
          ],
          "unknown_indices": []
        },
        {
          "text": "If the context is finalized, Hono returns context.res. Otherwise, the finalization check raises an Error.",
          "claim_ids": [
            "claim:b962178a-0e5d-4e27-a698-38b48e7fdd3a",
            "claim:7ce9d699-11e2-481a-866e-c1e4356ea24d"
          ],
          "unknown_indices": []
        }
      ],
      "stage_keys": [
        "handlers",
        "response",
        "failure"
      ]
    },
    {
      "key": "missing-response",
      "question": "What if a handler returns no response?",
      "answer": [
        {
          "text": "For a direct null or undefined result, Hono calls the not-found handler without checking finalized.",
          "claim_ids": [
            "claim:abe1d0e6-876f-40a3-b8e1-aac696dd56f5"
          ],
          "unknown_indices": []
        },
        {
          "text": "For a falsy Promise result, Hono first checks finalized. It uses c.res if finalized is true. Otherwise, it calls the not-found handler.",
          "claim_ids": [
            "claim:876a95e6-ca91-46c2-b831-60091068b69d"
          ],
          "unknown_indices": []
        },
        {
          "text": "After composition, an unfinalized context causes an Error.",
          "claim_ids": [
            "claim:b962178a-0e5d-4e27-a698-38b48e7fdd3a"
          ],
          "unknown_indices": []
        }
      ],
      "stage_keys": [
        "response",
        "failure"
      ]
    },
    {
      "key": "fallback-error",
      "question": "Can a not-found failure escape the local catch?",
      "answer": [
        {
          "text": "Yes. The direct not-found fallback runs outside the direct handler catch block. A synchronous throw there can reach the caller.",
          "claim_ids": [
            "claim:bf2950af-c55d-401a-9691-50acf819a3f2"
          ],
          "unknown_indices": []
        },
        {
          "text": "Caller handling is outside this source view.",
          "claim_ids": [],
          "unknown_indices": [
            4
          ]
        }
      ],
      "stage_keys": [
        "response",
        "failure"
      ]
    },
    {
      "key": "context",
      "question": "Does reading context.res finalize the response?",
      "answer": [
        {
          "text": "No. The getter can create response storage, but it does not set finalized. The setter sets finalized to true, even for undefined.",
          "claim_ids": [
            "claim:161b91b9-a49b-44d3-a919-0758464c5af3",
            "claim:1d2eae5b-efd0-4237-8671-50d5055dafe0"
          ],
          "unknown_indices": []
        }
      ],
      "stage_keys": [
        "response"
      ]
    }
  ],
  "sequence": null,
